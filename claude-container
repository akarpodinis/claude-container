#!/usr/bin/env bash
# claude-container — launch the Claude Code dev container from any repo
#
# Two containers are started per session:
#   1. A proxy sidecar that holds the real Docker socket and exposes a
#      filtered socket on a private named volume.
#   2. The agent container, which runs as an unprivileged user with all
#      capabilities dropped and sees only the filtered socket.

set -euo pipefail

IMAGE="claude-code-dev:latest"
PROXY_IMAGE="claude-docker-proxy:latest"
CONTAINER_HOME="${CLAUDE_CONTAINER_HOME:-${HOME}/.claude-container}"
MEMORY_LIMIT="${CLAUDE_CONTAINER_MEMORY:-8g}"
PIDS_LIMIT="${CLAUDE_CONTAINER_PIDS:-4096}"

if [[ "${1:-}" == "--container-help" || "${1:-}" == "-H" ]]; then
  cat <<HELP
Usage: claude-container [ARGS...] | [COMMAND...]

Launch Claude Code in a Docker container with your current directory mounted.

  claude-container                  Launch Claude Code interactively
  claude-container --model sonnet   Pass flags to Claude Code (default model: opus)
  claude-container bash             Run an arbitrary command in the container
  claude-container aws s3 ls        Use container tools directly
  claude-container sandbox-check    Verify the sandbox boundary is intact
  claude-container --container-help Show launcher help

Environment variables (passed through when set):
  AWS_PROFILE              AWS profile to use
  AWS_REGION               AWS region for API calls
  CLAUDE_CODE_USE_BEDROCK  Set to 1 for AWS Bedrock
  CLAUDE_GITHUB_TOKEN      GitHub personal access token for gh CLI

Launcher settings:
  CLAUDE_CONTAINER_HOME    Host dir for container-only Claude state
                           (default: ~/.claude-container)
  CLAUDE_CONTAINER_MEMORY  Memory limit for the agent container (default: 8g)
  CLAUDE_CONTAINER_PIDS    Process limit for the agent container (default: 4096)
HELP
  exit 0
fi

# Prerequisite checks
if ! docker info >/dev/null 2>&1; then
  echo "Error: Docker is not running" >&2
  exit 1
fi
for img in "$IMAGE" "$PROXY_IMAGE"; do
  if ! docker image inspect "$img" >/dev/null 2>&1; then
    echo "Error: Image $img not found. Build it with: make build" >&2
    exit 1
  fi
done

# Get absolute path of current directory
PWD_ABS="$(pwd)"
PWD_PARENT="$(dirname "${PWD_ABS}")"

# Container-only Claude state. This is deliberately NOT your host ~/.claude:
# anything the agent writes to its config (settings, hooks, memory) stays
# scoped to container sessions. Sign in once inside the container; the
# credentials persist here across runs.
mkdir -p "${CONTAINER_HOME}/claude"
[ -f "${CONTAINER_HOME}/claude.json" ] || echo '{}' > "${CONTAINER_HOME}/claude.json"

# Build volume mounts; skip optional paths that don't exist on the host
VOLUMES=(
  -v "${PWD_ABS}:${PWD_ABS}"
  -v "${CONTAINER_HOME}/claude:/home/dev/.claude:rw"
  -v "${CONTAINER_HOME}/claude.json:/home/dev/.claude.json:rw"
)
[ -d "${HOME}/.aws" ]      && VOLUMES+=(-v "${HOME}/.aws:/home/dev/.aws:ro")
if [ -f "${HOME}/.gitconfig" ]; then
  VOLUMES+=(-v "${HOME}/.gitconfig:/home/dev/.gitconfig:ro")
else
  echo "Warning: ~/.gitconfig not found; git identity will be unavailable in the container" >&2
fi
[ -d "${HOME}/.config/gh" ] && VOLUMES+=(-v "${HOME}/.config/gh:/home/dev/.config/gh:ro")

# Mount user plugin directory if it exists.
USER_PLUGINS="${HOME}/.claude-plugins"
if [ -d "$USER_PLUGINS" ]; then
  VOLUMES+=(-v "${USER_PLUGINS}:/home/dev/user-plugins:ro")
fi

# Per-session proxy sidecar. The named volume carries only the proxy's
# listening socket; the real daemon socket is mounted into the sidecar alone.
SESSION_ID="$(date +%s)-$$"
SOCK_VOLUME="claude-proxy-sock-${SESSION_ID}"
PROXY_NAME="claude-proxy-${SESSION_ID}"

cleanup() {
  docker rm -f "$PROXY_NAME" >/dev/null 2>&1 || true
  docker volume rm "$SOCK_VOLUME" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker volume create "$SOCK_VOLUME" >/dev/null
docker run -d --rm --name "$PROXY_NAME" \
  --network none \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --pids-limit 64 \
  -v /var/run/docker.sock:/var/run/docker-real.sock \
  -v "${SOCK_VOLUME}:/run/docker-proxy" \
  -e "ALLOWED_MOUNT_BASE=${PWD_PARENT}" \
  -e "ALLOWED_RW_BASE=${PWD_ABS}" \
  "$PROXY_IMAGE" >/dev/null

# Run the agent container. `set -e` is suspended around it so the exit code
# of claude (or the arbitrary command) is preserved and cleanup still runs.
set +e
docker run --rm -it \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --pids-limit "$PIDS_LIMIT" \
  --memory "$MEMORY_LIMIT" \
  "${VOLUMES[@]}" \
  -v "${SOCK_VOLUME}:/run/docker-proxy:ro" \
  -w "${PWD_ABS}" \
  ${AWS_PROFILE:+-e "AWS_PROFILE=${AWS_PROFILE}"} \
  ${AWS_REGION:+-e "AWS_REGION=${AWS_REGION}"} \
  ${CLAUDE_CODE_USE_BEDROCK:+-e "CLAUDE_CODE_USE_BEDROCK=${CLAUDE_CODE_USE_BEDROCK}"} \
  ${CLAUDE_GITHUB_TOKEN:+-e "GITHUB_TOKEN=${CLAUDE_GITHUB_TOKEN}"} \
  "$IMAGE" "$@"
STATUS=$?
set -e
exit "$STATUS"
