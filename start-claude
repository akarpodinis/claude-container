#!/usr/bin/env bash
# Entrypoint for the agent container. Runs as the unprivileged `dev` user;
# there is no root path inside this container.
set -euo pipefail

# Wait briefly for the proxy sidecar to publish its socket.
if [[ "${DOCKER_HOST:-}" == unix://* ]]; then
  PROXY_SOCK="${DOCKER_HOST#unix://}"
  for _ in $(seq 1 50); do
    [ -S "$PROXY_SOCK" ] && break
    sleep 0.1
  done
  if [ ! -S "$PROXY_SOCK" ]; then
    echo "Warning: Docker proxy socket $PROXY_SOCK not found; docker commands will fail" >&2
  fi
fi

# If first arg doesn't start with '-', run it as a command instead of claude
if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
  exec "$@"
fi

# Run claude with container plugin and --dangerously-skip-permissions
CLAUDE_ARGS=(
  --plugin-dir /home/dev/container-plugin
  --dangerously-skip-permissions
)

# Load user-supplied plugins if the directory was mounted
USER_PLUGINS=/home/dev/user-plugins
if [ -d "$USER_PLUGINS" ]; then
  CLAUDE_ARGS+=(--plugin-dir "$USER_PLUGINS")
fi

HAS_MODEL=false
for arg in "$@"; do
  case "$arg" in
    --model|--model=*) HAS_MODEL=true; break ;;
  esac
done

if [ "$HAS_MODEL" = false ]; then
  echo "No --model given; defaulting to 'opus' (override with --model <name>)" >&2
  CLAUDE_ARGS+=(--model opus)
fi

exec claude "${CLAUDE_ARGS[@]}" "$@"
